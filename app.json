{
  "expo": {
    "name": "VLivIn",
    "slug": "vlivin",
    "scheme": "vlivin",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    
    "ios": {
      "bundleIdentifier": "com.vlivin.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.vlivin.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://vlivin-backend-staging.onrender.com"
    }
  }
}
